{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "precog",
      "extra-files": [
        {
          "type": "toml",
          "path": "apps/api/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "apps/mcp/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/precog/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/precog/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    }
  }
}
